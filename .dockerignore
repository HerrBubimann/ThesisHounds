# Allowlist: no documents, .env, Git history, tests or local tool environments.
**
!backend/
!backend/app/
!backend/app/**
!backend/requirements.lock
!backend/Dockerfile
!frontend/
!frontend/app.py
!frontend/__init__.py
!frontend/api_client.py
!frontend/control_center.py
!frontend/requirements.lock
!frontend/Dockerfile
!frontend/.streamlit/
!frontend/.streamlit/config.toml
!infrastructure/
!infrastructure/ollama/
!infrastructure/ollama/Dockerfile
!config/
!config/models.yaml
!config/agents.yaml
!config/policies.yaml
!config/execution.yaml
# Re-exclude nested private/cache files even within allowed source directories.
**/__pycache__/
**/*.pyc
**/.env*
**/secrets.toml
**/*.pdf
**/*.doc
**/*.docx
**/*.odt
**/*.pptx
**/*.xlsx
**/uploads/
**/documents/
**/data/
**/reports/
**/*.pem
**/*.key
