# Allowlist: no documents, .env, Git history, tests or local tool environments.
**
!backend/
!backend/app/
!backend/app/**
!backend/requirements.lock
!backend/Dockerfile
!frontend/
!frontend/app.py
!frontend/__init__.py
!frontend/api_client.py
!frontend/egress.py
!frontend/control_center.py
!frontend/assessment_review.py
!frontend/design.py
!frontend/navigation.py
!frontend/pages.py
!frontend/viewmodels.py
!frontend/evidence.py
!frontend/sources.py
!frontend/requirements.lock
!frontend/Dockerfile
!frontend/.streamlit/
!frontend/.streamlit/config.toml
!infrastructure/
!infrastructure/ollama/
!infrastructure/ollama/Dockerfile
!config/
!config/models.yaml
!config/agents.yaml
!config/policies.yaml
!config/execution.yaml
!config/model_capabilities.yaml
!config/assessment_profiles/
!config/assessment_profiles/*.yaml
!config/institutions/
!config/institutions/dhbw/
!config/institutions/dhbw/mosbach/
!config/institutions/dhbw/mosbach/data_science_ai/
