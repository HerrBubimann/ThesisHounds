# REVIEWED TEMPLATE ONLY. University IT must adapt interfaces and verify Docker
# backend (iptables/nftables), bridge filtering, VPN, DNS and host INPUT/OUTPUT.
# Do not flush existing rules or install automatically. Apply as a separate table
# after `nft --check --file ...`; preserve SSH/management and unrelated traffic.
table inet thesishounds_private {
    chain forward {
        type filter hook forward priority -10; policy accept;
        ct state established,related accept
        # No public egress from either private processing subnet.
        ip saddr 172.30.10.3 ip daddr 172.30.10.2 tcp dport 8000 accept
        ip saddr 172.30.20.2 ip daddr 172.30.20.3 tcp dport 11434 accept
        ip saddr { 172.30.10.0/24, 172.30.20.0/24 } counter drop
        # IPv6 must be disabled on the protected bridges at deployment. Never
        # add a generic IPv6 accept path for them; test link-local addresses too.
    }
}
