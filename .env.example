# Model tags must match `ollama list` exactly. No cloud model tags.
LLM_MODEL=qwen3:8b
# Optional aliases: OLLAMA_DEFAULT_MODEL, OLLAMA_REQUEST_TIMEOUT override legacy names.
DEPLOYMENT_MODE=local
SECURITY_MODE=DEVELOPMENT
INFERENCE_MODE=mock
# local_pilot requires independently reviewed model artifacts and a confirmed PA1
# EXPERIMENT profile. See docs/setup.md before enabling.
# UNIVERSITY_SECURE is blocked pending verified identity, infrastructure and organizational release.
MAX_CONCURRENT_MODEL_REQUESTS=1
ENABLE_PUBLIC_RESEARCH=false
ENABLE_INTERNAL_RESEARCH=false
ENABLE_AI_SCORING=false
# University mode only: exact approved hostname list (JSON), verified HTTPS endpoint,
# optional OLLAMA_CA_FILE and OLLAMA_AUTH_TOKEN supplied by the university, never committed.
UNIVERSITY_OLLAMA_HOSTS=[]
UNIVERSITY_OLLAMA_IPS=[]
FRONTEND_PORT=8501
LLM_CONNECT_TIMEOUT=5
LLM_STATUS_TIMEOUT=10
LLM_CHAT_TIMEOUT=300
# Keep this higher than LLM_CHAT_TIMEOUT + LLM_STATUS_TIMEOUT.
FRONTEND_REQUEST_TIMEOUT=320
LLM_MAX_TOKENS=512
LLM_CONTEXT_LENGTH=4096
# Only needed for development OUTSIDE Docker; Compose sets internal URLs itself.
OLLAMA_BASE_URL=http://localhost:11434
BACKEND_URL=http://localhost:8000
FRONTEND_CPUS=1.0
FRONTEND_MEMORY=1g
BACKEND_CPUS=2.0
BACKEND_MEMORY=1g
OLLAMA_CPUS=4.0
OLLAMA_MEMORY=12g
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1

# Optional host-only PUBLIC metadata snapshots, reviewed independently and stored outside Git.
# No automatic download, no private research history. Docker needs an explicit read-only mount.
# PUBLIC_METADATA_DIR=C:\ApprovedPublicMetadata
# Optional host-only, reviewed local scientific artifacts; no automatic model downloads.
# LOCAL_EMBEDDING_MANIFEST_DIR=C:\ApprovedEmbeddingManifests
# CITATION_STYLE_DIR=C:\ApprovedCitationStyles
# ENABLE_LOCAL_LANGUAGE_TOOL=false
